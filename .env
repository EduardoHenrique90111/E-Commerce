# Variáveis públicas (expostas no bundle). Nunca coloque segredos aqui.
# Liga a camada de mocks (MSW: REST + Socket.IO) — obrigatório para a demonstração.
VITE_ENABLE_MOCKS=true
# Mostra o painel "Simulação" (cenários, reset, eventos em tempo real).
VITE_MOCK_DEVTOOLS=true
# Base da API REST. Com mocks, as rotas /api/* são atendidas pelo MSW.
VITE_API_BASE_URL=/api
# Servidor Socket.IO. Vazio = mesma origem da página. Com mocks, a conexão é interceptada pelo MSW.
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
