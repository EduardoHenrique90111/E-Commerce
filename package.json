{
  "name": "kurio-nft-marketplace",
  "private": true,
  "version": "1.0.0",
  "description": "Kurio — marketplace de NFTs (descoberta, compra e conta do colecionador) com API, sessão, carteiras, pagamentos e tempo real simulados via MSW.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --mode development",
    "build": "tsc -b && vite build",
    "build:demo": "vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:report": "playwright show-report reports/playwright",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets:generate": "node scripts/generate-art.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "msw:init": "msw init public --save",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@mswjs/socket.io-binding": "0.1.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.120.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "msw": "^2.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lighthouse": "^12.8.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
